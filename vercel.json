{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/languagetool-api/:path*",
      "destination": "https://api.languagetool.org/v2/:path*"
    },
    {
      "source": "/tatoeba-api/:path*",
      "destination": "https://tatoeba.org/en/api_v0/:path*"
    },
    {
      "source": "/gcp-tts-api",
      "destination": "https://texttospeech.googleapis.com/v1/text:synthesize"
    },
    {
      "source": "/google-tts-api",
      "destination": "https://translate.google.com/translate_tts"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
